#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 22) readonly buffer CellData { uvec2 cellData[]; };
layout(std430, binding = 23) writeonly buffer InverseCellData { uvec2 inverseCellData[]; };

layout(push_constant) uniform PushConstants {
    int nParticles;
    int stepTicks;
    int globalTime;
    float minDt;
    float gravityG;
    float boxCenter;
    float boxSize;
    float gravitySoftening;
    int workItems;
    int parentStride;
    int stride;
    int sortIteration;
    int cellTableSize;
    int uncheckedParentStride;
    int gravityLevelParity;
    int dispatchOffset;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.nParticles)) return;
    uint oldIndex = cellData[i].y;
    inverseCellData[oldIndex] = uvec2(0u, i);
}
