float integer_powf(float x, int n) {
    if (n == 0) return 1.0;
    if (n == 1) return x;
    if (n == 2) return x * x;
    if (n == 3) return x * x * x;
    return pow(x, float(n));
}

int binomial(int p, int n) {
    return binomialCoeffs[p * 5 + n];
}

float D_soft_1(float u) {
    float phi = -3.0 * u + 15.0;
    phi = phi * u - 28.0;
    phi = phi * u + 21.0;
    phi = phi * u;
    phi = phi * u - 7.0;
    phi = phi * u;
    phi = phi * u + 3.0;
    return phi;
}

float D_soft_2(float u) {
    float phi = -21.0 * u + 90.0;
    phi = phi * u - 140.0;
    phi = phi * u + 84.0;
    phi = phi * u;
    phi = phi * u - 14.0;
    phi = phi * u;
    return phi;
}

float D_soft_3(float u) {
    float phi = -105.0 * u + 360.0;
    phi = phi * u - 420.0;
    phi = phi * u + 168.0;
    phi = phi * u;
    phi = phi * u;
    return phi;
}

float D_soft_4(float u) {
    float phi = -315.0 * u + 720.0;
    phi = phi * u - 420.0;
    phi = phi * u;
    phi = phi * u;
    return phi;
}

float D_soft_5(float u) {
    float phi = -315.0 * u;
    phi = phi * u + 420.0;
    phi = phi * u;
    return phi;
}

Derivatives derivatives(vec3 vec, float eps) {
    float Dt1;
    float Dt2;
    float Dt3;
    float Dt4;
    float Dt5;
    float r2 = dot(vec, vec);
    float r = sqrt(r2);
    float rInv = r > 1e-6 ? 1.0 / r : 0.0;
    float eps2 = eps * eps;
    if (eps > 0.0 && r2 < eps2) {
        float epsInv = 1.0 / eps;
        float u = r * epsInv;
        Dt1 = epsInv * D_soft_1(u);
        float epsInv2 = epsInv * epsInv;
        Dt2 = epsInv2 * D_soft_2(u);
        float epsInv3 = epsInv2 * epsInv;
        Dt3 = epsInv3 * D_soft_3(u);
        float epsInv4 = epsInv3 * epsInv;
        Dt4 = epsInv4 * D_soft_4(u);
#if MULTIPOLE_EXPANSION_POWER > 3
        float epsInv5 = epsInv4 * epsInv;
        Dt5 = epsInv5 * D_soft_5(u);
#endif
    } else {
        Dt1 = rInv;
        Dt2 = -Dt1 * rInv;
        Dt3 = -3.0 * Dt2 * rInv;
        Dt4 = -5.0 * Dt3 * rInv;
#if MULTIPOLE_EXPANSION_POWER > 3
        Dt5 = -7.0 * Dt4 * rInv;
#endif
    }

    vec3 rr = vec * rInv;
    vec3 rr2 = rr * rr;
    vec3 rr3 = rr2 * rr;
#if MULTIPOLE_EXPANSION_POWER > 3
    vec3 rr4 = rr3 * rr;
#endif
    Derivatives dev;
    for (int i = 0; i < N_EXPANSION_TERMS; ++i) dev.expansion[i] = 0.0;
    dev.expansion[M] = Dt1;
    dev.expansion[X] = rr.x * Dt2;
    dev.expansion[Y] = rr.y * Dt2;
    dev.expansion[Z] = rr.z * Dt2;

#if MULTIPOLE_EXPANSION_POWER > 1
    Dt2 *= rInv;
    dev.expansion[XX] = rr2.x * Dt3 + Dt2;
    dev.expansion[XY] = rr.x * rr.y * Dt3;
    dev.expansion[XZ] = rr.x * rr.z * Dt3;
    dev.expansion[YY] = rr2.y * Dt3 + Dt2;
    dev.expansion[YZ] = rr.y * rr.z * Dt3;
    dev.expansion[ZZ] = rr2.z * Dt3 + Dt2;
#endif

#if MULTIPOLE_EXPANSION_POWER > 2
    Dt3 *= rInv;
    dev.expansion[XXX] = rr3.x * Dt4 + 3.0 * rr.x * Dt3;
    dev.expansion[YYY] = rr3.y * Dt4 + 3.0 * rr.y * Dt3;
    dev.expansion[ZZZ] = rr3.z * Dt4 + 3.0 * rr.z * Dt3;
    dev.expansion[XXY] = rr2.x * rr.y * Dt4 + rr.y * Dt3;
    dev.expansion[XXZ] = rr2.x * rr.z * Dt4 + rr.z * Dt3;
    dev.expansion[XYY] = rr2.y * rr.x * Dt4 + rr.x * Dt3;
    dev.expansion[YYZ] = rr2.y * rr.z * Dt4 + rr.z * Dt3;
    dev.expansion[XZZ] = rr2.z * rr.x * Dt4 + rr.x * Dt3;
    dev.expansion[YZZ] = rr2.z * rr.y * Dt4 + rr.y * Dt3;
    dev.expansion[XYZ] = rr.x * rr.y * rr.z * Dt4;
#endif
#if MULTIPOLE_EXPANSION_POWER > 3
    Dt3 *= rInv;
    Dt4 *= rInv;
    dev.expansion[XXXX] = rr4.x * Dt5 + 6.0 * rr2.x * Dt4 + 3.0 * Dt3;
    dev.expansion[YYYY] = rr4.y * Dt5 + 6.0 * rr2.y * Dt4 + 3.0 * Dt3;
    dev.expansion[ZZZZ] = rr4.z * Dt5 + 6.0 * rr2.z * Dt4 + 3.0 * Dt3;
    dev.expansion[XXXY] = rr3.x * rr.y * Dt5 + 3.0 * rr.x * rr.y * Dt4;
    dev.expansion[XXXZ] = rr3.x * rr.z * Dt5 + 3.0 * rr.x * rr.z * Dt4;
    dev.expansion[XYYY] = rr3.y * rr.x * Dt5 + 3.0 * rr.y * rr.x * Dt4;
    dev.expansion[YYYZ] = rr3.y * rr.z * Dt5 + 3.0 * rr.y * rr.z * Dt4;
    dev.expansion[XZZZ] = rr3.z * rr.x * Dt5 + 3.0 * rr.z * rr.x * Dt4;
    dev.expansion[YZZZ] = rr3.z * rr.y * Dt5 + 3.0 * rr.z * rr.y * Dt4;
    dev.expansion[XXYY] = rr2.x * rr2.y * Dt5 + rr2.x * Dt4 + rr2.y * Dt4 + Dt3;
    dev.expansion[XXZZ] = rr2.x * rr2.z * Dt5 + rr2.x * Dt4 + rr2.z * Dt4 + Dt3;
    dev.expansion[YYZZ] = rr2.y * rr2.z * Dt5 + rr2.y * Dt4 + rr2.z * Dt4 + Dt3;
    dev.expansion[XXYZ] = rr2.x * rr.y * rr.z * Dt5 + rr.y * rr.z * Dt4;
    dev.expansion[XYYZ] = rr2.y * rr.x * rr.z * Dt5 + rr.x * rr.z * Dt4;
    dev.expansion[XYZZ] = rr2.z * rr.x * rr.y * Dt5 + rr.x * rr.y * Dt4;
#endif
    return dev;
}

float dphi_dr(vec3 xij, float eta) {
    if (eta <= 0.0) return 1.0 / max(dot(xij, xij), 1e-30);
    float etaInv = 1.0 / eta;
    float r = length(xij);
    float q = r * etaInv;

    if (q <= 1.0) {
        return etaInv * etaInv * ((4.0 / 3.0) * q - (6.0 / 5.0) * q * q * q + 0.5 * q * q * q * q);
    }
    if (q <= 2.0) {
        float qInv = 1.0 / q;
        return etaInv * etaInv * ((8.0 / 3.0) * q - 3.0 * q * q + (6.0 / 5.0) * q * q * q -
                                  (1.0 / 6.0) * q * q * q * q - (1.0 / 15.0) * qInv * qInv);
    }

    return 1.0 / max(r * r, 1e-30);
}

bool m2lAccept(Multipole A, Multipole B) {
    float rhoA = A.size;
    float rhoB = B.size;
    if (rhoA + rhoB < 1e-12) return true;
    float r2 = dot(A.pos.xyz - B.pos.xyz, A.pos.xyz - B.pos.xyz);
    float rhoSum = rhoA + rhoB;
    if (rhoSum * rhoSum > r2) return false;
    float rhoMax = max(rhoA, rhoB);
    const int p = MULTIPOLE_EXPANSION_POWER;
    float e = 0.0;
    for (int n = 0; n <= p; ++n) e += float(binomial(p, n)) * B.power[n] * integer_powf(rhoA, p - n);
    e *= 8.0 * rhoMax;
    e /= rhoSum;
    float rToP = integer_powf(r2, p / 2);
    return e < GRAVITY_ETA * A.minGrav * rToP * r2;
}

bool m2pAccept(vec3 x, float prevGrav, Multipole B) {
    float rhoB = B.size;
    if (rhoB < 1e-12) return true;
    float r2 = dot(x - B.pos.xyz, x - B.pos.xyz);
    if (rhoB * rhoB > r2) return false;
    const int p = MULTIPOLE_EXPANSION_POWER;
    float e = 8.0 * float(binomial(p, p)) * B.power[p];
    float rToP = integer_powf(r2, p / 2);
    return e < GRAVITY_ETA * prevGrav * rToP * r2;
}

void m2l(Multipole mp, inout Local local) {
    vec3 r = local.pos.xyz - mp.pos.xyz;
    Derivatives d = derivatives(r, mp.eta);
    float M000 = mp.expansion[M];
    local.expansion[M] += M000 * d.expansion[M];
    local.expansion[X] += M000 * d.expansion[X];
    local.expansion[Y] += M000 * d.expansion[Y];
    local.expansion[Z] += M000 * d.expansion[Z];

#if MULTIPOLE_EXPANSION_POWER > 1
    float M200 = mp.expansion[XX], M020 = mp.expansion[YY], M002 = mp.expansion[ZZ];
    float M110 = mp.expansion[XY], M101 = mp.expansion[XZ], M011 = mp.expansion[YZ];
    local.expansion[M] += M200 * d.expansion[XX] + M020 * d.expansion[YY] + M002 * d.expansion[ZZ];
    local.expansion[M] += M110 * d.expansion[XY] + M101 * d.expansion[XZ] + M011 * d.expansion[YZ];
    local.expansion[XX] += M000 * d.expansion[XX];
    local.expansion[YY] += M000 * d.expansion[YY];
    local.expansion[ZZ] += M000 * d.expansion[ZZ];
    local.expansion[XY] += M000 * d.expansion[XY];
    local.expansion[XZ] += M000 * d.expansion[XZ];
    local.expansion[YZ] += M000 * d.expansion[YZ];
#endif

#if MULTIPOLE_EXPANSION_POWER > 2
    float M300 = mp.expansion[XXX], M030 = mp.expansion[YYY], M003 = mp.expansion[ZZZ];
    float M210 = mp.expansion[XXY], M201 = mp.expansion[XXZ], M021 = mp.expansion[YYZ];
    float M120 = mp.expansion[XYY], M012 = mp.expansion[YZZ], M102 = mp.expansion[XZZ], M111 = mp.expansion[XYZ];
    local.expansion[M] += M300 * d.expansion[XXX] + M030 * d.expansion[YYY] + M003 * d.expansion[ZZZ];
    local.expansion[M] += M210 * d.expansion[XXY] + M201 * d.expansion[XXZ] + M120 * d.expansion[XYY];
    local.expansion[M] += M021 * d.expansion[YYZ] + M102 * d.expansion[XZZ] + M012 * d.expansion[YZZ] + M111 * d.expansion[XYZ];
    local.expansion[X] += M200 * d.expansion[XXX] + M020 * d.expansion[XYY] + M002 * d.expansion[XZZ];
    local.expansion[X] += M110 * d.expansion[XXY] + M101 * d.expansion[XXZ] + M011 * d.expansion[XYZ];
    local.expansion[Y] += M200 * d.expansion[XXY] + M020 * d.expansion[YYY] + M002 * d.expansion[YZZ];
    local.expansion[Y] += M110 * d.expansion[XYY] + M101 * d.expansion[XYZ] + M011 * d.expansion[YYZ];
    local.expansion[Z] += M200 * d.expansion[XXZ] + M020 * d.expansion[YYZ] + M002 * d.expansion[ZZZ];
    local.expansion[Z] += M110 * d.expansion[XYZ] + M101 * d.expansion[XZZ] + M011 * d.expansion[YZZ];
    local.expansion[XXX] += M000 * d.expansion[XXX];
    local.expansion[YYY] += M000 * d.expansion[YYY];
    local.expansion[ZZZ] += M000 * d.expansion[ZZZ];
    local.expansion[XXY] += M000 * d.expansion[XXY];
    local.expansion[XXZ] += M000 * d.expansion[XXZ];
    local.expansion[XYY] += M000 * d.expansion[XYY];
    local.expansion[YYZ] += M000 * d.expansion[YYZ];
    local.expansion[XZZ] += M000 * d.expansion[XZZ];
    local.expansion[YZZ] += M000 * d.expansion[YZZ];
    local.expansion[XYZ] += M000 * d.expansion[XYZ];
#endif

#if MULTIPOLE_EXPANSION_POWER > 3
    float M400 = mp.expansion[XXXX], M040 = mp.expansion[YYYY], M004 = mp.expansion[ZZZZ];
    float M310 = mp.expansion[XXXY], M301 = mp.expansion[XXXZ], M031 = mp.expansion[YYYZ];
    float M130 = mp.expansion[XYYY], M013 = mp.expansion[YZZZ], M103 = mp.expansion[XZZZ];
    float M220 = mp.expansion[XXYY], M202 = mp.expansion[XXZZ], M022 = mp.expansion[YYZZ];
    float M211 = mp.expansion[XXYZ], M121 = mp.expansion[XYYZ], M112 = mp.expansion[XYZZ];

    float D400 = d.expansion[XXXX], D040 = d.expansion[YYYY], D004 = d.expansion[ZZZZ];
    float D310 = d.expansion[XXXY], D301 = d.expansion[XXXZ], D031 = d.expansion[YYYZ];
    float D130 = d.expansion[XYYY], D013 = d.expansion[YZZZ], D103 = d.expansion[XZZZ];
    float D220 = d.expansion[XXYY], D202 = d.expansion[XXZZ], D022 = d.expansion[YYZZ];
    float D211 = d.expansion[XXYZ], D121 = d.expansion[XYYZ], D112 = d.expansion[XYZZ];

    local.expansion[M] += M004 * D004 + M013 * D013 + M022 * D022 + M031 * D031;
    local.expansion[M] += M040 * D040 + M103 * D103 + M112 * D112 + M121 * D121;
    local.expansion[M] += M130 * D130 + M202 * D202 + M211 * D211 + M220 * D220;
    local.expansion[M] += M301 * D301 + M310 * D310 + M400 * D400;

    local.expansion[Z] += M003 * D004 + M012 * D013 + M021 * D022 + M030 * D031;
    local.expansion[Z] += M102 * D103 + M111 * D112 + M120 * D121 + M201 * D202;
    local.expansion[Z] += M210 * D211 + M300 * D301;
    local.expansion[Y] += M003 * D013 + M012 * D022 + M021 * D031 + M030 * D040;
    local.expansion[Y] += M102 * D112 + M111 * D121 + M120 * D130 + M201 * D211;
    local.expansion[Y] += M210 * D220 + M300 * D310;
    local.expansion[X] += M003 * D103 + M012 * D112 + M021 * D121 + M030 * D130;
    local.expansion[X] += M102 * D202 + M111 * D211 + M120 * D220 + M201 * D301;
    local.expansion[X] += M210 * D310 + M300 * D400;

    local.expansion[ZZ] += M002 * D004 + M011 * D013 + M020 * D022 + M101 * D103 + M110 * D112 + M200 * D202;
    local.expansion[YZ] += M002 * D013 + M011 * D022 + M020 * D031 + M101 * D112 + M110 * D121 + M200 * D211;
    local.expansion[YY] += M002 * D022 + M011 * D031 + M020 * D040 + M101 * D121 + M110 * D130 + M200 * D220;
    local.expansion[XZ] += M002 * D103 + M011 * D112 + M020 * D121 + M101 * D202 + M110 * D211 + M200 * D301;
    local.expansion[XY] += M002 * D112 + M011 * D121 + M020 * D130 + M101 * D211 + M110 * D220 + M200 * D310;
    local.expansion[XX] += M002 * D202 + M011 * D211 + M020 * D220 + M101 * D301 + M110 * D310 + M200 * D400;

    local.expansion[ZZZZ] += M000 * D004;
    local.expansion[YZZZ] += M000 * D013;
    local.expansion[YYZZ] += M000 * D022;
    local.expansion[YYYZ] += M000 * D031;
    local.expansion[YYYY] += M000 * D040;
    local.expansion[XZZZ] += M000 * D103;
    local.expansion[XYZZ] += M000 * D112;
    local.expansion[XYYZ] += M000 * D121;
    local.expansion[XYYY] += M000 * D130;
    local.expansion[XXZZ] += M000 * D202;
    local.expansion[XXYZ] += M000 * D211;
    local.expansion[XXYY] += M000 * D220;
    local.expansion[XXXZ] += M000 * D301;
    local.expansion[XXXY] += M000 * D310;
    local.expansion[XXXX] += M000 * D400;
#endif
}

vec3 l2p(Local local, vec3 pos) {
    vec3 r = pos - local.pos.xyz;
    vec3 acc = vec3(local.expansion[X], local.expansion[Y], local.expansion[Z]);
#if MULTIPOLE_EXPANSION_POWER > 1
    acc.x += r.x * local.expansion[XX] + r.y * local.expansion[XY] + r.z * local.expansion[XZ];
    acc.y += r.x * local.expansion[XY] + r.y * local.expansion[YY] + r.z * local.expansion[YZ];
    acc.z += r.x * local.expansion[XZ] + r.y * local.expansion[YZ] + r.z * local.expansion[ZZ];
#endif
#if MULTIPOLE_EXPANSION_POWER > 2
    acc.x += 0.5 * r.x * r.x * local.expansion[XXX] + 0.5 * r.y * r.y * local.expansion[XYY] + 0.5 * r.z * r.z * local.expansion[XZZ];
    acc.x += r.x * r.y * local.expansion[XXY] + r.x * r.z * local.expansion[XXZ] + r.y * r.z * local.expansion[XYZ];
    acc.y += 0.5 * r.x * r.x * local.expansion[XXY] + 0.5 * r.y * r.y * local.expansion[YYY] + 0.5 * r.z * r.z * local.expansion[YZZ];
    acc.y += r.x * r.y * local.expansion[XYY] + r.x * r.z * local.expansion[XYZ] + r.y * r.z * local.expansion[YYZ];
    acc.z += 0.5 * r.x * r.x * local.expansion[XXZ] + 0.5 * r.y * r.y * local.expansion[YYZ] + 0.5 * r.z * r.z * local.expansion[ZZZ];
    acc.z += r.x * r.y * local.expansion[XYZ] + r.x * r.z * local.expansion[XZZ] + r.y * r.z * local.expansion[YZZ];
#endif
#if MULTIPOLE_EXPANSION_POWER > 3
    acc.x += 0.1666666666666667 * r.z * r.z * r.z * local.expansion[XZZZ] +
             0.5 * r.y * r.z * r.z * local.expansion[XYZZ] +
             0.5 * r.y * r.y * r.z * local.expansion[XYYZ] +
             0.1666666666666667 * r.y * r.y * r.y * local.expansion[XYYY] +
             0.5 * r.x * r.z * r.z * local.expansion[XXZZ] +
             r.x * r.y * r.z * local.expansion[XXYZ] +
             0.5 * r.x * r.y * r.y * local.expansion[XXYY] +
             0.5 * r.x * r.x * r.z * local.expansion[XXXZ] +
             0.5 * r.x * r.x * r.y * local.expansion[XXXY] +
             0.1666666666666667 * r.x * r.x * r.x * local.expansion[XXXX];
    acc.y += 0.1666666666666667 * r.z * r.z * r.z * local.expansion[YZZZ] +
             0.5 * r.y * r.z * r.z * local.expansion[YYZZ] +
             0.5 * r.y * r.y * r.z * local.expansion[YYYZ] +
             0.1666666666666667 * r.y * r.y * r.y * local.expansion[YYYY] +
             0.5 * r.x * r.z * r.z * local.expansion[XYZZ] +
             r.x * r.y * r.z * local.expansion[XYYZ] +
             0.5 * r.x * r.y * r.y * local.expansion[XYYY] +
             0.5 * r.x * r.x * r.z * local.expansion[XXYZ] +
             0.5 * r.x * r.x * r.y * local.expansion[XXYY] +
             0.1666666666666667 * r.x * r.x * r.x * local.expansion[XXXY];
    acc.z += 0.1666666666666667 * r.z * r.z * r.z * local.expansion[ZZZZ] +
             0.5 * r.y * r.z * r.z * local.expansion[YZZZ] +
             0.5 * r.y * r.y * r.z * local.expansion[YYZZ] +
             0.1666666666666667 * r.y * r.y * r.y * local.expansion[YYYZ] +
             0.5 * r.x * r.z * r.z * local.expansion[XZZZ] +
             r.x * r.y * r.z * local.expansion[XYZZ] +
             0.5 * r.x * r.y * r.y * local.expansion[XYYZ] +
             0.5 * r.x * r.x * r.z * local.expansion[XXZZ] +
             0.5 * r.x * r.x * r.y * local.expansion[XXYZ] +
             0.1666666666666667 * r.x * r.x * r.x * local.expansion[XXXZ];
#endif
    return acc;
}

vec3 m2p(Multipole mp, vec3 x) {
    Local local;
    local.pos = vec4(x, 0.0);
    for (int i = 0; i < N_EXPANSION_TERMS; ++i) local.expansion[i] = 0.0;
    m2l(mp, local);
    return l2p(local, x);
}

Local transformLocal(Local local, vec3 r) {
    Local outLocal = local;
    outLocal.pos = vec4(local.pos.xyz + r, 0.0);
    float x = r.x, y = r.y, z = r.z;
    outLocal.expansion[M] += x * local.expansion[X] + y * local.expansion[Y] + z * local.expansion[Z];
#if MULTIPOLE_EXPANSION_POWER > 1
    float x2 = x * x, y2 = y * y, z2 = z * z;
    outLocal.expansion[M] += 0.5 * x2 * local.expansion[XX] + 0.5 * y2 * local.expansion[YY] + 0.5 * z2 * local.expansion[ZZ];
    outLocal.expansion[M] += x * y * local.expansion[XY] + x * z * local.expansion[XZ] + y * z * local.expansion[YZ];
    outLocal.expansion[X] += x * local.expansion[XX] + y * local.expansion[XY] + z * local.expansion[XZ];
    outLocal.expansion[Y] += x * local.expansion[XY] + y * local.expansion[YY] + z * local.expansion[YZ];
    outLocal.expansion[Z] += x * local.expansion[XZ] + y * local.expansion[YZ] + z * local.expansion[ZZ];
#endif

#if MULTIPOLE_EXPANSION_POWER > 2
    float x3 = x2 * x, y3 = y2 * y, z3 = z2 * z;
    outLocal.expansion[M] += (x3 / 6.0) * local.expansion[XXX] + (y3 / 6.0) * local.expansion[YYY] + (z3 / 6.0) * local.expansion[ZZZ];
    outLocal.expansion[M] += 0.5 * x2 * y * local.expansion[XXY] + 0.5 * x2 * z * local.expansion[XXZ] + 0.5 * x * y2 * local.expansion[XYY];
    outLocal.expansion[M] += 0.5 * y2 * z * local.expansion[YYZ] + 0.5 * x * z2 * local.expansion[XZZ] + 0.5 * y * z2 * local.expansion[YZZ];
    outLocal.expansion[M] += x * y * z * local.expansion[XYZ];
    outLocal.expansion[X] += 0.5 * x2 * local.expansion[XXX] + 0.5 * y2 * local.expansion[XYY] + 0.5 * z2 * local.expansion[XZZ];
    outLocal.expansion[X] += x * y * local.expansion[XXY] + x * z * local.expansion[XXZ] + y * z * local.expansion[XYZ];
    outLocal.expansion[Y] += 0.5 * x2 * local.expansion[XXY] + 0.5 * y2 * local.expansion[YYY] + 0.5 * z2 * local.expansion[YZZ];
    outLocal.expansion[Y] += x * y * local.expansion[XYY] + x * z * local.expansion[XYZ] + y * z * local.expansion[YYZ];
    outLocal.expansion[Z] += 0.5 * x2 * local.expansion[XXZ] + 0.5 * y2 * local.expansion[YYZ] + 0.5 * z2 * local.expansion[ZZZ];
    outLocal.expansion[Z] += x * y * local.expansion[XYZ] + x * z * local.expansion[XZZ] + y * z * local.expansion[YZZ];
    outLocal.expansion[XX] += x * local.expansion[XXX] + y * local.expansion[XXY] + z * local.expansion[XXZ];
    outLocal.expansion[YY] += x * local.expansion[XYY] + y * local.expansion[YYY] + z * local.expansion[YYZ];
    outLocal.expansion[ZZ] += x * local.expansion[XZZ] + y * local.expansion[YZZ] + z * local.expansion[ZZZ];
    outLocal.expansion[XY] += x * local.expansion[XXY] + y * local.expansion[XYY] + z * local.expansion[XYZ];
    outLocal.expansion[XZ] += x * local.expansion[XXZ] + y * local.expansion[XYZ] + z * local.expansion[XZZ];
    outLocal.expansion[YZ] += x * local.expansion[XYZ] + y * local.expansion[YYZ] + z * local.expansion[YZZ];
#endif
#if MULTIPOLE_EXPANSION_POWER > 3
    float R400 = x * x3;
    float R040 = y * y3;
    float R004 = z * z3;
    float R310 = x3 * y;
    float R301 = x3 * z;
    float R130 = x * y3;
    float R031 = y3 * z;
    float R103 = x * z3;
    float R013 = y * z3;
    float R220 = x2 * y2;
    float R202 = x2 * z2;
    float R022 = y2 * z2;
    float R211 = x2 * y * z;
    float R121 = x * y2 * z;
    float R112 = x * y * z2;

    float X400 = 0.041666666666666667 * R400;
    float X040 = 0.041666666666666667 * R040;
    float X004 = 0.041666666666666667 * R004;
    float X310 = 0.1666666666666667 * R310;
    float X301 = 0.1666666666666667 * R301;
    float X130 = 0.1666666666666667 * R130;
    float X031 = 0.1666666666666667 * R031;
    float X103 = 0.1666666666666667 * R103;
    float X013 = 0.1666666666666667 * R013;
    float X220 = 0.25 * R220;
    float X202 = 0.25 * R202;
    float X022 = 0.25 * R022;
    float X211 = 0.5 * R211;
    float X121 = 0.5 * R121;
    float X112 = 0.5 * R112;

    outLocal.expansion[M] += X004 * local.expansion[ZZZZ] + X013 * local.expansion[YZZZ] +
        X022 * local.expansion[YYZZ] + X031 * local.expansion[YYYZ] +
        X040 * local.expansion[YYYY] + X103 * local.expansion[XZZZ] +
        X112 * local.expansion[XYZZ] + X121 * local.expansion[XYYZ] +
        X130 * local.expansion[XYYY] + X202 * local.expansion[XXZZ] +
        X211 * local.expansion[XXYZ] + X220 * local.expansion[XXYY] +
        X301 * local.expansion[XXXZ] + X310 * local.expansion[XXXY] +
        X400 * local.expansion[XXXX];

    outLocal.expansion[Z] += (z3 / 6.0) * local.expansion[ZZZZ] +
        0.5 * y * z2 * local.expansion[YZZZ] +
        0.5 * y2 * z * local.expansion[YYZZ] +
        (y3 / 6.0) * local.expansion[YYYZ] +
        0.5 * x * z2 * local.expansion[XZZZ] +
        x * y * z * local.expansion[XYZZ] +
        0.5 * x * y2 * local.expansion[XYYZ] +
        0.5 * x2 * z * local.expansion[XXZZ] +
        0.5 * x2 * y * local.expansion[XXYZ] +
        (x3 / 6.0) * local.expansion[XXXZ];
    outLocal.expansion[Y] += (z3 / 6.0) * local.expansion[YZZZ] +
        0.5 * y * z2 * local.expansion[YYZZ] +
        0.5 * y2 * z * local.expansion[YYYZ] +
        (y3 / 6.0) * local.expansion[YYYY] +
        0.5 * x * z2 * local.expansion[XYZZ] +
        x * y * z * local.expansion[XYYZ] +
        0.5 * x * y2 * local.expansion[XYYY] +
        0.5 * x2 * z * local.expansion[XXYZ] +
        0.5 * x2 * y * local.expansion[XXYY] +
        (x3 / 6.0) * local.expansion[XXXY];
    outLocal.expansion[X] += (z3 / 6.0) * local.expansion[XZZZ] +
        0.5 * y * z2 * local.expansion[XYZZ] +
        0.5 * y2 * z * local.expansion[XYYZ] +
        (y3 / 6.0) * local.expansion[XYYY] +
        0.5 * x * z2 * local.expansion[XXZZ] +
        x * y * z * local.expansion[XXYZ] +
        0.5 * x * y2 * local.expansion[XXYY] +
        0.5 * x2 * z * local.expansion[XXXZ] +
        0.5 * x2 * y * local.expansion[XXXY] +
        (x3 / 6.0) * local.expansion[XXXX];

    outLocal.expansion[ZZ] += 0.5 * z2 * local.expansion[ZZZZ] +
        y * z * local.expansion[YZZZ] +
        0.5 * y2 * local.expansion[YYZZ] +
        x * z * local.expansion[XZZZ] +
        x * y * local.expansion[XYZZ] +
        0.5 * x2 * local.expansion[XXZZ];
    outLocal.expansion[YZ] += 0.5 * z2 * local.expansion[YZZZ] +
        y * z * local.expansion[YYZZ] +
        0.5 * y2 * local.expansion[YYYZ] +
        x * z * local.expansion[XYZZ] +
        x * y * local.expansion[XYYZ] +
        0.5 * x2 * local.expansion[XXYZ];
    outLocal.expansion[YY] += 0.5 * z2 * local.expansion[YYZZ] +
        y * z * local.expansion[YYYZ] +
        0.5 * y2 * local.expansion[YYYY] +
        x * z * local.expansion[XYYZ] +
        x * y * local.expansion[XYYY] +
        0.5 * x2 * local.expansion[XXYY];
    outLocal.expansion[XZ] += 0.5 * z2 * local.expansion[XZZZ] +
        y * z * local.expansion[XYZZ] +
        0.5 * y2 * local.expansion[XYYZ] +
        x * z * local.expansion[XXZZ] +
        x * y * local.expansion[XXYZ] +
        0.5 * x2 * local.expansion[XXXZ];
    outLocal.expansion[XY] += 0.5 * z2 * local.expansion[XYZZ] +
        y * z * local.expansion[XYYZ] +
        0.5 * y2 * local.expansion[XYYY] +
        x * z * local.expansion[XXYZ] +
        x * y * local.expansion[XXYY] +
        0.5 * x2 * local.expansion[XXXY];
    outLocal.expansion[XX] += 0.5 * z2 * local.expansion[XXZZ] +
        y * z * local.expansion[XXYZ] +
        0.5 * y2 * local.expansion[XXYY] +
        x * z * local.expansion[XXXZ] +
        x * y * local.expansion[XXXY] +
        0.5 * x2 * local.expansion[XXXX];

    outLocal.expansion[ZZZ] += z * local.expansion[ZZZZ] + y * local.expansion[YZZZ] + x * local.expansion[XZZZ];
    outLocal.expansion[YZZ] += z * local.expansion[YZZZ] + y * local.expansion[YYZZ] + x * local.expansion[XYZZ];
    outLocal.expansion[YYZ] += z * local.expansion[YYZZ] + y * local.expansion[YYYZ] + x * local.expansion[XYYZ];
    outLocal.expansion[YYY] += z * local.expansion[YYYZ] + y * local.expansion[YYYY] + x * local.expansion[XYYY];
    outLocal.expansion[XZZ] += z * local.expansion[XZZZ] + y * local.expansion[XYZZ] + x * local.expansion[XXZZ];
    outLocal.expansion[XYZ] += z * local.expansion[XYZZ] + y * local.expansion[XYYZ] + x * local.expansion[XXYZ];
    outLocal.expansion[XYY] += z * local.expansion[XYYZ] + y * local.expansion[XYYY] + x * local.expansion[XXYY];
    outLocal.expansion[XXZ] += z * local.expansion[XXZZ] + y * local.expansion[XXYZ] + x * local.expansion[XXXZ];
    outLocal.expansion[XXY] += z * local.expansion[XXYZ] + y * local.expansion[XXYY] + x * local.expansion[XXXY];
    outLocal.expansion[XXX] += z * local.expansion[XXXZ] + y * local.expansion[XXXY] + x * local.expansion[XXXX];
#endif
    return outLocal;
}

bool checkAndAddLocal(int toScan, Multipole mp, inout Local local, bool forceAccept) {
    int nodeData = tree[toScan + 1];
    Multipole nodeMp = multipoles[nodeData];
    if (forceAccept || m2lAccept(mp, nodeMp)) {
        m2l(nodeMp, local);
        return true;
    }
    return false;
}

int readUnchecked(int idx) {
    return pc.gravityLevelParity == 0 ? localGravA[idx] : localGravB[idx];
}

void writeUnchecked(int idx, int value) {
    if (pc.gravityLevelParity == 0) localGravB[idx] = value;
    else localGravA[idx] = value;
}

void zeroFirstBranches() {
    for (int i = 2; i < 10; ++i) {
        int nodePointer = tree[i];
        if (nodePointer == -1) continue;
        int nodeData = tree[nodePointer + 1];
        locals[nodeData].pos = vec4(multipoles[nodeData].pos.xyz, 0.0);
        for (int j = 0; j < N_EXPANSION_TERMS; ++j) locals[nodeData].expansion[j] = 0.0;
    }
    writeUnchecked(0, 0);
    writeUnchecked(1, -1);
}

void nonRecursiveScan(Multipole mp, inout Local local, inout int outputPointer, int maxOutputPointer, int toScan, int treePointer) {
    bool leaf = tree[toScan] != 0;
    if (checkAndAddLocal(toScan, mp, local, leaf && outputPointer >= maxOutputPointer)) return;
    if (leaf) {
        if (outputPointer < maxOutputPointer) writeUnchecked(outputPointer, toScan);
        outputPointer++;
        return;
    }
    for (int j = toScan + 2; j < toScan + 10; ++j) {
        int childPointer = tree[j];
        if (childPointer == treePointer || childPointer == -1) continue;
        if (!checkAndAddLocal(childPointer, mp, local, outputPointer >= maxOutputPointer)) {
            if (outputPointer < maxOutputPointer) writeUnchecked(outputPointer, childPointer);
            outputPointer++;
        }
    }
}

void addUncheckedLeaf(int nodePointer,
                      int treePointer,
                      int nTargets,
                      int targetParticles[8],
                      vec3 targetPositions[8],
                      float targetPrevGrav[8],
                      inout vec3 targetAcc[8],
                      float curDt) {
    if (nodePointer == treePointer) return;
    int np = tree[nodePointer];
    if (np <= 0 || np > 8) return;
    int dataPointer = tree[nodePointer + 1];
    Multipole ump = multipoles[dataPointer];
    for (int t = 0; t < 8; ++t) {
        if (t >= nTargets) break;
        int particle = targetParticles[t];
        if (particle < 0 || particle >= pc.nParticles) continue;
        vec3 xi = targetPositions[t];
        if (m2pAccept(xi, targetPrevGrav[t], ump)) {
            targetAcc[t] += m2p(ump, xi);
            continue;
        }
        for (int j = nodePointer + 2; j < nodePointer + 2 + np; ++j) {
            int pj = tree[j];
            if (pj < 0 || pj >= pc.nParticles || pj == particle) continue;
            vec3 xj = positions[pj].xyz + 0.5 * curDt * velocities[pj].xyz;
            vec3 xij = xi - xj;
            float r = length(xij);
            if (r == 0.0) continue;
            float eta = min(smoothingLengths[pj] * GAMMA * PLUMBER_EQUIVALENT, pc.gravitySoftening);
            targetAcc[t] -= masses[pj] * dphi_dr(xij, eta) * (xij / r);
        }
    }
}

void recursiveScanLeaf(Multipole mp,
                       inout Local local,
                       int toScan,
                       int treePointer,
                       int nTargets,
                       int targetParticles[8],
                       vec3 targetPositions[8],
                       float targetPrevGrav[8],
                       inout vec3 targetAcc[8],
                       float curDt) {
    if (toScan == treePointer) return;
    bool leaf = tree[toScan] != 0;
    if (checkAndAddLocal(toScan, mp, local, false)) return;
    if (leaf) {
        addUncheckedLeaf(toScan, treePointer, nTargets, targetParticles, targetPositions, targetPrevGrav, targetAcc, curDt);
        return;
    }

    int indexes[GRAVITY_MAX_RECURSION];
    int ends[GRAVITY_MAX_RECURSION];
    int currentDepth = 0;
    indexes[0] = toScan + 2;
    ends[0] = indexes[0] + 8;
    int guard = 0;
    while (indexes[0] < ends[0] && guard < 2000) {
        guard++;
        int nodePointer = tree[indexes[currentDepth]];
        if (nodePointer == treePointer || nodePointer == -1) {
            indexes[currentDepth]++;
            while (indexes[currentDepth] == ends[currentDepth] && currentDepth != 0) {
                currentDepth--;
                indexes[currentDepth]++;
            }
            continue;
        }
        bool nodeLeaf = tree[nodePointer] != 0;
        bool forceAccept = !nodeLeaf && currentDepth == GRAVITY_MAX_RECURSION - 1;
        if (!checkAndAddLocal(nodePointer, mp, local, forceAccept)) {
            if (!nodeLeaf && currentDepth + 1 < GRAVITY_MAX_RECURSION) {
                currentDepth++;
                indexes[currentDepth] = nodePointer + 2;
                ends[currentDepth] = indexes[currentDepth] + 8;
                continue;
            }
            if (nodeLeaf) {
                addUncheckedLeaf(nodePointer, treePointer, nTargets, targetParticles, targetPositions, targetPrevGrav, targetAcc, curDt);
            }
        }
        indexes[currentDepth]++;
        while (indexes[currentDepth] == ends[currentDepth] && currentDepth != 0) {
            currentDepth--;
            indexes[currentDepth]++;
        }
    }
}

void l2l(Multipole mp, Local local, int treePointer) {
    for (int j = treePointer + 2; j < treePointer + 10; ++j) {
        int nodePointer = tree[j];
        if (nodePointer == -1) continue;
        int nodeData = tree[nodePointer + 1];
        Multipole nodeMp = multipoles[nodeData];
        vec3 r = nodeMp.pos.xyz - local.pos.xyz;
        locals[nodeData] = transformLocal(local, r);
    }
}

void initLeafTargets(int treePointer,
                     int nParticles,
                     float curDt,
                     out int targetParticles[8],
                     out vec3 targetPositions[8],
                     out float targetPrevGrav[8],
                     out vec3 targetAcc[8]) {
    for (int t = 0; t < 8; ++t) {
        if (t < nParticles) {
            int particle = tree[treePointer + 2 + t];
            targetParticles[t] = particle;
            if (particle >= 0 && particle < pc.nParticles) {
                targetPositions[t] = positions[particle].xyz + 0.5 * curDt * velocities[particle].xyz;
                targetPrevGrav[t] = gravAbs[particle];
            } else {
                targetPositions[t] = vec3(0.0);
                targetPrevGrav[t] = 0.0;
            }
        } else {
            targetParticles[t] = -1;
            targetPositions[t] = vec3(0.0);
            targetPrevGrav[t] = 0.0;
        }
        targetAcc[t] = vec3(0.0);
    }
}

void localToLeaf(Local local, int nParticles, int targetParticles[8], vec3 targetPositions[8], inout vec3 targetAcc[8]) {
    for (int t = 0; t < 8; ++t) {
        if (t >= nParticles) break;
        int particle = targetParticles[t];
        if (particle < 0 || particle >= pc.nParticles) continue;
        vec3 xi = targetPositions[t];
        vec3 acc = l2p(local, xi) + targetAcc[t];
        for (int j = 0; j < 8; ++j) {
            if (j >= nParticles) break;
            if (t == j) continue;
            int pj = targetParticles[j];
            if (pj < 0 || pj >= pc.nParticles) continue;
            vec3 xj = targetPositions[j];
            vec3 xij = xi - xj;
            float r = length(xij);
            if (r == 0.0) continue;
            float eta = min(smoothingLengths[pj] * GAMMA * PLUMBER_EQUIVALENT, pc.gravitySoftening);
            acc -= masses[pj] * dphi_dr(xij, eta) * (xij / r);
        }
        vec3 grav = pc.gravityG * acc;
        float gnorm = length(grav);
        gravAccelerations[particle] = vec4(grav, 0.0);
        gravAbs[particle] = gnorm / pc.gravityG;
        float dtF = GDT * sqrt(smoothingLengths[particle] / max(gnorm, 1e-30));
        float goalDt = clamp(dtF, pc.minDt, MAX_DT);
        int integerDt = 1;
        while (2.0 * pc.minDt * float(integerDt) < goalDt && 2.0 * pc.minDt * float(integerDt) < MAX_DT) {
            integerDt += integerDt;
        }
        atomicMin(stepTicks[0], integerDt);
        atomicMin(gravityStepTicks[0], integerDt);
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x + uint(pc.dispatchOffset);
    if (i >= uint(pc.workItems)) return;

    int treePointer = treeLevel[pc.parentStride + int(i)];
    if (treePointer < 0) return;
    if (treePointer == 0) {
        zeroFirstBranches();
        return;
    }

    int dataPointer = tree[treePointer + 1];
    Multipole mp = multipoles[dataPointer];
    Local local = locals[dataPointer];
    int nParticles = tree[treePointer];
    if (nParticles < 0 || nParticles > 8) return;

    uint parentIndex = parentIndexes[dataPointer];
    int startScan = int(parentIndex) * pc.uncheckedParentStride;
    int endScan = startScan + pc.uncheckedParentStride;
    float curDt = pc.minDt * float(pc.stepTicks);
    if (nParticles == 0) {
        int outputPointer = int(i) * pc.stride;
        int maxOutputPointer = outputPointer + pc.stride;
        if (outputPointer < maxOutputPointer) {
            writeUnchecked(outputPointer, treePointer);
            outputPointer++;
        }
        for (int s = startScan; s < endScan; ++s) {
            int toScan = readUnchecked(s);
            if (toScan == -1) break;
            if (toScan < 0) continue;
            nonRecursiveScan(mp, local, outputPointer, maxOutputPointer, toScan, treePointer);
        }
        if (outputPointer < maxOutputPointer) writeUnchecked(outputPointer, -1);
        l2l(mp, local, treePointer);
        return;
    }

    int targetParticles[8];
    vec3 targetPositions[8];
    float targetPrevGrav[8];
    vec3 targetAcc[8];
    initLeafTargets(treePointer, nParticles, curDt, targetParticles, targetPositions, targetPrevGrav, targetAcc);
    for (int s = startScan; s < endScan; ++s) {
        int toScan = readUnchecked(s);
        if (toScan == -1) break;
        if (toScan < 0) continue;
        recursiveScanLeaf(mp, local, toScan, treePointer, nParticles, targetParticles, targetPositions, targetPrevGrav, targetAcc, curDt);
    }
    localToLeaf(local, nParticles, targetParticles, targetPositions, targetAcc);
}
