#version 450

layout(local_size_x = 1) in;

#include "sph_params.glsl"

layout(std430, binding = 26) buffer BucketOffset { uint bucketOffset[]; };

void main() {
    uint count = 0u;
    for (int i = 0; i < SORTING_BUCKET_NUMBER; ++i) {
        count += bucketOffset[i];
        bucketOffset[i] = count;
    }
}
