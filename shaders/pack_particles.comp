#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 1) readonly buffer Densities { float densities[]; };
layout(std430, binding = 2) readonly buffer SmoothingLengths { float smoothingLengths[]; };
layout(std430, binding = 5) readonly buffer RhoGrads { vec4 rhoGrads[]; };
layout(std430, binding = 7) writeonly buffer InstanceIds { uint instanceIds[]; };
layout(std430, binding = 8) buffer VisibleCount { uint visibleCount[]; };
layout(std430, binding = 9) buffer IndirectArgs { uint indirectArgs[]; };

layout(push_constant) uniform PushConstants {
    int nParticles;
    float cameraX;
    float cameraY;
    float cameraZ;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.nParticles)) return;
    vec3 pos = positions[i].xyz;
    float rho = densities[i];
    vec3 grad = rhoGrads[i].xyz;
    float g2 = dot(grad, grad);
    bool visible = true;
    if (g2 > 1e-12 && rho > 0.0005) {
        float g = sqrt(g2);
        vec3 normal = -grad / g;
        float distToEdge = 0.3 * (rho - 0.001) / g;
        vec3 cameraPos = vec3(pc.cameraX, pc.cameraY, pc.cameraZ);
        vec3 lightDirection = vec3(-1.0, -1.0, 0.5);
        visible = distToEdge < 4.0 * sqrt(smoothingLengths[i]) &&
            (dot(pos - cameraPos, normal) > 0.0 || dot(lightDirection, normal) > 0.0);
    }
    if (!visible) return;
    uint dst = atomicAdd(visibleCount[0], 1u);
    instanceIds[dst] = i;
}
